generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  STARTER
  PROFESIONAL
  AGENCIA
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  clients   Client[]
  services  ServiceBase[]
  auditLogs AuditLog[]
  expenses  MonthlyExpense[]
  monthlyCosts MonthlyCost[]
  suggestions  Suggestion[]

  planTier           PlanTier           @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(NONE)
  mpSubscriptionId   String?
  mpPayerEmail       String?
  currentPeriodEnd   DateTime?
  isDemo             Boolean            @default(false)
}

// One row per tier, editable from /admin/plans — pricing and limits are
// business decisions that shouldn't require a redeploy to change.
model Plan {
  id                  String   @id @default(cuid())
  tier                PlanTier @unique
  name                String
  description         String
  priceAmount         Float    @default(0)
  currency            String   @default("ARS")
  billingInterval      String   @default("monthly")
  clientLimit         Int?
  userLimit           Int?
  featured            Boolean  @default(false)
  features            Json
  mpPreapprovalPlanId String?
  updatedAt           DateTime @updatedAt
}

// Single shared row: Mercado Pago credentials, managed from the superadmin
// panel instead of .env — same pattern as SmtpSettings.
model MercadoPagoSettings {
  id          String   @id @default("singleton")
  accessToken String
  publicKey   String
  updatedAt   DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(OPERATOR)
  isSuperAdmin  Boolean   @default(false)
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id])
  auditLogs     AuditLog[]
  accounts      Account[]
  sessions      Session[]
  suggestions   Suggestion[]
  createdAt     DateTime  @default(now())
}

// Single shared row: platform-wide SMTP config, managed from the superadmin
// panel instead of .env, since it needs to be editable without a redeploy.
model SmtpSettings {
  id        String   @id @default("singleton")
  host      String
  port      Int      @default(587)
  user      String
  password  String
  from      String
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
  READONLY
}

model Client {
  id          String            @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  cuit        String?
  country     String?
  currency    String            @default("USD")
  notes       String?
  status      String            @default("ACTIVE")
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  contracts   ServiceContract[]
  oneTime     OneTimeService[]
  createdAt   DateTime          @default(now())
}

model ServiceBase {
  id          String            @id @default(cuid())
  name        String
  type        String
  description String?
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  contracts   ServiceContract[]
  oneTime     OneTimeService[]
}

model ServiceContract {
  id             String      @id @default(cuid())
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceBaseId  String
  serviceBase    ServiceBase @relation(fields: [serviceBaseId], references: [id])
  provider       String?
  cost           Float       @default(0)
  price          Float
  frequency      String
  startDate      DateTime    @default(now())
  autoRenew      Boolean     @default(false)
  notes          String?
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  payments       ContractPayment[]
  monthlyCosts   MonthlyCost[] @relation("ContractMonthlyCosts")
}

model MonthlyCost {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  name        String
  amount      Float
  createdAt   DateTime          @default(now())
  contracts   ServiceContract[] @relation("ContractMonthlyCosts")
}

model ContractPayment {
  id         String          @id @default(cuid())
  contractId String
  contract   ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dueDate    DateTime
  amount     Float
  isPaid       Boolean         @default(false)
  paidAt       DateTime?
  invoiced     Boolean         @default(false)
  invoiceSent  Boolean         @default(false)
  createdAt    DateTime        @default(now())
}

model OneTimeService {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceBaseId String
  serviceBase   ServiceBase @relation(fields: [serviceBaseId], references: [id])
  name          String?
  internalCost  Float       @default(0)
  finalPrice    Float
  startDate     DateTime?
  deliveryDate  DateTime?
  isPaid        Boolean     @default(false)
  invoiced      Boolean     @default(false)
  invoiceSent   Boolean     @default(false)
  notes         String?
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime  @default(now())
}

model MonthlyExpense {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  month       DateTime
  description String
  amount      Float
  createdAt   DateTime  @default(now())
}

model Suggestion {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  createdAt   DateTime  @default(now())
}
